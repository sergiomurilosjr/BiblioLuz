{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Information about a book in the library stock.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "Title of the book" },
        "author": { "type": "string", "description": "Author of the book" },
        "isbn": { "type": "string", "description": "ISBN identifier" },
        "category": { "type": "string", "description": "Genre or category" },
        "cdeIndex": { "type": "string", "description": "Índice CDE (Classificação Decimal Espírita)" },
        "edition": { "type": "string", "description": "Edição do livro" },
        "year": { "type": "string", "description": "Ano de publicação" },
        "acquisitionType": { "type": "string", "description": "Forma de Aquisição" },
        "supplier": { "type": "string", "description": "Fornecedor" },
        "status": { "type": "string", "enum": ["available", "loaned"], "description": "Current status" },
        "coverUrl": { "type": "string", "format": "uri", "maxLength": 300000, "description": "URL or compressed base64 data URI to book cover image" },
        "description": { "type": "string", "description": "Short summary" },
        "ownerId": { "type": "string", "description": "UID of the user who owns the book inventory" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "author", "status", "ownerId"]
    },
    "Loan": {
      "title": "Loan",
      "description": "A record of a book being borrowed.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string", "description": "ID of the borrowed book" },
        "bookTitle": { "type": "string" },
        "cdeIndex": { "type": "string", "description": "Índice CDE" },
        "borrowerName": { "type": "string", "description": "Name of the person borrowing the book" },
        "borrowerEmail": { "type": "string", "format": "email" },
        "borrowerPhone": { "type": "string", "description": "Phone number" },
        "borrowerPhoneNormalized": { "type": "string", "maxLength": 50, "description": "Normalized WhatsApp digits" },
        "responsible": { "type": "string", "description": "Person responsible for the loan" },
        "notes": { "type": "string", "description": "Observations" },
        "loanDate": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" },
        "returnDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "returned", "overdue", "lost"] },
        "lastReminderAt": { "type": "string", "format": "date-time", "description": "Timestamp of the last WhatsApp reminder sent" },
        "reminderCount": { "type": "integer", "description": "Number of WhatsApp reminders sent" },
        "agreedToTerms": { "type": "boolean", "description": "Whether the borrower agreed to the 30-day term and WhatsApp reminder" },
        "agreedAt": { "type": "string", "format": "date-time" },
        "reminderScheduledFor": { "type": "string", "format": "date-time", "description": "Scheduled date for the 3-days-before-due WhatsApp reminder" },
        "reminderStatus": { "type": "string", "enum": ["scheduled", "sent", "cancelled", "none"] },
        "extensionCount": { "type": "integer", "description": "Number of +15 day extensions granted" },
        "lastExtensionAt": { "type": "string", "format": "date-time" },
        "returnClaimedAt": { "type": "string", "format": "date-time", "description": "Timestamp when reader clicked Já devolvi" },
        "returnClaimStatus": { "type": "string", "enum": ["none", "pending_verification", "resolved"] },
        "ownerId": { "type": "string", "description": "UID of the library owner or self-service" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookId", "borrowerName", "loanDate", "borrowerPhone", "status", "ownerId"]
    },
    "Borrower": {
      "title": "Borrower",
      "description": "Directory of readers who borrow books.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Reader name" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "description": "Reader phone number" },
        "phoneNormalized": { "type": "string", "maxLength": 50, "description": "Normalized WhatsApp phone digits" },
        "verified": { "type": "boolean", "description": "Whether the WhatsApp phone number was verified" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "lastBorrowed": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "ownerId"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Collection of books in the library."
    },
    "/loans/{loanId}": {
      "schema": "Loan",
      "description": "Collection of loan records."
    },
    "/borrowers/{borrowerId}": {
      "schema": "Borrower",
      "description": "Collection of registered borrowers."
    }
  }
}
