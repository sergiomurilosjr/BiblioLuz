rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(data) { return isSignedIn() && data.ownerId == request.auth.uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // --- Validation Blueprints ---
    
    function isValidBook(data) {
      return data.title is string && data.title.size() <= 2000
          && data.author is string && data.author.size() <= 1000
          && data.status in ['available', 'loaned']
          && data.ownerId == request.auth.uid
          && (data.get('isbn', '') is string && data.get('isbn', '').size() <= 200)
          && (data.get('category', '') is string && data.get('category', '').size() <= 1000)
          && (data.get('cdeIndex', '') is string && data.get('cdeIndex', '').size() <= 500)
          && (data.get('edition', '') is string && data.get('edition', '').size() <= 500)
          && (data.get('year', '') is string && data.get('year', '').size() <= 200)
          && (data.get('acquisitionType', '') is string && data.get('acquisitionType', '').size() <= 1000)
          && (data.get('supplier', '') is string && data.get('supplier', '').size() <= 1000)
          && (data.get('description', '') is string && data.get('description', '').size() <= 40000)
          && (data.get('coverUrl', '') is string && data.get('coverUrl', '').size() <= 5000);
    }

    function isValidLoan(data) {
      return data.bookId is string && data.bookId.size() <= 128
          && data.bookTitle is string && data.bookTitle.size() <= 2000
          && data.borrowerName is string && data.borrowerName.size() >= 1 && data.borrowerName.size() <= 1000
          && data.status in ['active', 'returned', 'overdue', 'lost']
          && data.ownerId == request.auth.uid
          && (data.loanDate is timestamp || data.loanDate == request.time)
          && (data.get('cdeIndex', '') is string && data.get('cdeIndex', '').size() <= 500)
          && (data.get('borrowerPhone', '') is string && data.get('borrowerPhone', '').size() <= 200)
          && (data.get('borrowerEmail', '') is string && data.get('borrowerEmail', '').size() <= 500)
          && (data.get('responsible', '') is string && data.get('responsible', '').size() <= 500)
          && (data.get('notes', '') is string && data.get('notes', '').size() <= 20000)
          && (data.get('dueDate', null) == null || data.dueDate is timestamp)
          && (data.get('returnDate', null) == null || data.returnDate is timestamp);
    }

    function isValidBorrower(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 1000
          && data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 200
          && data.ownerId == request.auth.uid
          && (data.get('email', '') is string && data.get('email', '').size() <= 500)
          && (data.get('lastBorrowed', null) == null || data.lastBorrowed is timestamp);
    }

    // --- Collections ---

    match /books/{bookId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(bookId) && isValidBook(incoming())
                    && (incoming().get('createdAt', request.time) == request.time)
                    && (incoming().get('updatedAt', request.time) == request.time);
      
      allow update: if isOwner(existing()) && isValidBook(incoming()) 
                    && (incoming().get('createdAt', existing().createdAt) == existing().createdAt)
                    && (incoming().get('updatedAt', request.time) == request.time)
                    && (
        // Action: General Edit
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'author', 'isbn', 'category', 'cdeIndex', 'edition', 'year', 'acquisitionType', 'supplier', 'description', 'coverUrl', 'updatedAt']) ||
        // Action: Simple Status Change (e.g. when loaning)
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      
      allow delete: if isOwner(existing());
    }

    match /loans/{loanId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(loanId) && isValidLoan(incoming())
                    && (incoming().get('createdAt', request.time) == request.time)
                    && (incoming().get('updatedAt', request.time) == request.time);
      
      allow update: if isOwner(existing()) && isValidLoan(incoming())
                    && (incoming().get('createdAt', existing().get('createdAt', request.time)) == existing().get('createdAt', request.time))
                    && (incoming().get('updatedAt', request.time) == request.time)
                    && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'returnDate', 'loanDate', 'dueDate', 'borrowerName', 'borrowerEmail', 'borrowerPhone', 'responsible', 'notes', 'updatedAt'])
      );
      
      allow delete: if isOwner(existing());
    }

    match /borrowers/{borrowerId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(borrowerId) && isValidBorrower(incoming());
      
      allow update: if isOwner(existing()) && isValidBorrower(incoming())
                    && (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'lastBorrowed']));
      
      allow delete: if isOwner(existing());
    }
  }
}
